{ Start of the row of the root element for a target; -1 if the model has
  no profile for it.
  DE: Beginn der Zeile des Wurzelelements fuer ein Ziel; -1, wenn das
  Modell kein Profil dafuer hat. }
function LandrixGaebXmlTargetRow(const ATarget: TLandrixGaebTarget): Integer;

implementation

function LandrixGaebXmlTargetRow(const ATarget: TLandrixGaebTarget): Integer;
begin
  Result := -1;
  if (ATarget.Version = gv32) and (ATarget.Edition = ge2013_10) and (ATarget.Phase = gp81) then
    Result := 0;
  if (ATarget.Version = gv32) and (ATarget.Edition = ge2013_10) and (ATarget.Phase = gp83) then
    Result := 617;
  if (ATarget.Version = gv32) and (ATarget.Edition = ge2013_10) and (ATarget.Phase = gp84) then
    Result := 1191;
  if (ATarget.Version = gv32) and (ATarget.Edition = ge2013_10) and (ATarget.Phase = gp86) then
    Result := 1650;
  if (ATarget.Version = gv33) and (ATarget.Edition = ge2019_11) and (ATarget.Phase = gp81) then
    Result := 2264;
  if (ATarget.Version = gv33) and (ATarget.Edition = ge2019_11) and (ATarget.Phase = gp83) then
    Result := 2883;
  if (ATarget.Version = gv33) and (ATarget.Edition = ge2019_11) and (ATarget.Phase = gp84) then
    Result := 3459;
  if (ATarget.Version = gv33) and (ATarget.Edition = ge2019_11) and (ATarget.Phase = gp86) then
    Result := 3991;
  if (ATarget.Version = gv33) and (ATarget.Edition = ge2021_05) and (ATarget.Phase = gp81) then
    Result := 4607;
  if (ATarget.Version = gv33) and (ATarget.Edition = ge2021_05) and (ATarget.Phase = gp83) then
    Result := 5226;
  if (ATarget.Version = gv33) and (ATarget.Edition = ge2021_05) and (ATarget.Phase = gp84) then
    Result := 5802;
  if (ATarget.Version = gv33) and (ATarget.Edition = ge2021_05) and (ATarget.Phase = gp86) then
    Result := 6334;
end;

end.
