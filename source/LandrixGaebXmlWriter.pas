procedure WriteAddress(W: TLandrixGaebXmlWriteContext; O: TLandrixGaebXmlAddress; const AName: TLandrixXmlUtf8;
  ARow: Integer);
var
  I: TLandrixGaebListIndex;
begin
  W.StartElement(AName, False);
  if O.Name1 <> '' then
    W.ValueText(ARow + 0, 'Name1', O.Name1)
  else if O.IsMarkedEmpty('Name1') then
    W.ValueText(ARow + 0, 'Name1', '');
  if O.Name2 <> '' then
    W.ValueText(ARow + 1, 'Name2', O.Name2)
  else if O.IsMarkedEmpty('Name2') then
    W.ValueText(ARow + 1, 'Name2', '');
  if O.Name3 <> '' then
    W.ValueText(ARow + 2, 'Name3', O.Name3)
  else if O.IsMarkedEmpty('Name3') then
    W.ValueText(ARow + 2, 'Name3', '');
  if O.Name4 <> '' then
    W.ValueText(ARow + 3, 'Name4', O.Name4)
  else if O.IsMarkedEmpty('Name4') then
    W.ValueText(ARow + 3, 'Name4', '');
  if O.Street <> '' then
    W.ValueText(ARow + 4, 'Street', O.Street)
  else if O.IsMarkedEmpty('Street') then
    W.ValueText(ARow + 4, 'Street', '');
  if O.PCode <> '' then
    W.ValueText(ARow + 5, 'PCode', O.PCode)
  else if O.IsMarkedEmpty('PCode') then
    W.ValueText(ARow + 5, 'PCode', '');
  if O.City <> '' then
    W.ValueText(ARow + 6, 'City', O.City)
  else if O.IsMarkedEmpty('City') then
    W.ValueText(ARow + 6, 'City', '');
  if O.Country <> '' then
    W.ValueText(ARow + 7, 'Country', O.Country)
  else if O.IsMarkedEmpty('Country') then
    W.ValueText(ARow + 7, 'Country', '');
  if O.ILN <> '' then
    W.ValueText(ARow + 8, 'ILN', O.ILN)
  else if O.IsMarkedEmpty('ILN') then
    W.ValueText(ARow + 8, 'ILN', '');
  if O.HasCtlgAssign then
    for I := 0 to O.CtlgAssign.Count - 1 do
      if O.CtlgAssign[I].IsPresent and W.Allowed(ARow + 9, 'CtlgAssign', False) then
        WriteCtlgAssign(W, O.CtlgAssign[I], 'CtlgAssign', W.ChildRow(ARow + 9));
  if O.Contact <> '' then
    W.ValueText(ARow + 10, 'Contact', O.Contact)
  else if O.IsMarkedEmpty('Contact') then
    W.ValueText(ARow + 10, 'Contact', '');
  if O.Phone <> '' then
    W.ValueText(ARow + 11, 'Phone', O.Phone)
  else if O.IsMarkedEmpty('Phone') then
    W.ValueText(ARow + 11, 'Phone', '');
  if O.Fax <> '' then
    W.ValueText(ARow + 12, 'Fax', O.Fax)
  else if O.IsMarkedEmpty('Fax') then
    W.ValueText(ARow + 12, 'Fax', '');
  if O.Email <> '' then
    W.ValueText(ARow + 13, 'Email', O.Email)
  else if O.IsMarkedEmpty('Email') then
    W.ValueText(ARow + 13, 'Email', '');
  if O.VATID <> '' then
    W.ValueText(ARow + 14, 'VATID', O.VATID)
  else if O.IsMarkedEmpty('VATID') then
    W.ValueText(ARow + 14, 'VATID', '');
  if O.HasBank then
    for I := 0 to O.Bank.Count - 1 do
      if O.Bank[I].IsPresent and W.Allowed(ARow + 15, 'Bank', False) then
        WriteBank(W, O.Bank[I], 'Bank', W.ChildRow(ARow + 15));
  W.EndElement;
end;

procedure WriteAddText(W: TLandrixGaebXmlWriteContext; O: TLandrixGaebXmlAddText; const AName: TLandrixXmlUtf8;
  ARow: Integer);
begin
  W.StartElement(AName, False);
  if O.HasOutlineAddText and W.Allowed(ARow + 0, 'OutlineAddText', False) then
    WriteMLText(W, O.OutlineAddText, 'OutlineAddText', W.ChildRow(ARow + 0));
  if O.HasDetailAddText and W.Allowed(ARow + 1, 'DetailAddText', False) then
    WriteFText(W, O.DetailAddText, 'DetailAddText', W.ChildRow(ARow + 1));
  W.EndElement;
end;

procedure WriteArticle(W: TLandrixGaebXmlWriteContext; O: TLandrixGaebXmlArticle; const AName: TLandrixXmlUtf8;
  ARow: Integer);
var
  I: TLandrixGaebListIndex;
begin
  W.StartElement(AName, False);
  if O.Brand <> '' then
    W.ValueText(ARow + 0, 'Brand', O.Brand)
  else if O.IsMarkedEmpty('Brand') then
    W.ValueText(ARow + 0, 'Brand', '');
  if O.ArtNo <> '' then
    W.ValueText(ARow + 1, 'ArtNo', O.ArtNo)
  else if O.IsMarkedEmpty('ArtNo') then
    W.ValueText(ARow + 1, 'ArtNo', '');
  if O.Qty.HasValue then
    W.ValueDecimal(ARow + 2, 'Qty', O.Qty);
  if O.QU <> '' then
    W.ValueText(ARow + 3, 'QU', O.QU)
  else if O.IsMarkedEmpty('QU') then
    W.ValueText(ARow + 3, 'QU', '');
  if O.HasArtOutline and W.Allowed(ARow + 4, 'ArtOutline', False) then
    WriteMLText(W, O.ArtOutline, 'ArtOutline', W.ChildRow(ARow + 4));
  if O.HasAddText then
    for I := 0 to O.AddText.Count - 1 do
