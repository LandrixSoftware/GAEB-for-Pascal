procedure ReadAward(C: TLandrixGaebXmlReadContext; O: TLandrixGaebXmlAward);
var
  I, D, Last: Integer;
  GCnstSiteGroup: TLandrixGaebXmlAwardCnstSiteGroup;
  GCnstSiteGroupLast: Integer;
begin
  C.Enter(O);
  for I := 0 to C.Reader.AttributeCount - 1 do
    if C.IsPlainAttribute(I) then
      C.UnknownAttribute(I);
  D := C.Reader.Depth;
  Last := -1;
  GCnstSiteGroup := nil;
  GCnstSiteGroupLast := -1;
  while C.Next(D) do
    case C.Reader.TokenType of
      xttStartElement:
        if C.IsGaeb then
          if C.NameIs('DP') then
          begin
            if C.Order(Last, 0, True, (O.DP <> '')) then
            begin
              O.DP := C.ElementText;
            end;
          end
          else if C.NameIs('AwardInfo') then
          begin
            if C.Order(Last, 1, True, O.HasAwardInfo) then
            begin
              ReadAwardInfo(C, O.AwardInfo);
            end;
          end
          else if C.NameIs('OWN') then
          begin
            if C.Order(Last, 2, True, O.HasOWN) then
            begin
              ReadOWN(C, O.OWN);
            end;
          end
          else if C.NameIs('Requester') then
          begin
            if C.Order(Last, 3, False, False) then
            begin
              ReadRequester(C, O.Requester.Add);
            end;
          end
          else if C.NameIs('CnstSite') then
          begin
            if C.Order(Last, 4, False, False) then
            begin
              if (GCnstSiteGroup = nil) or C.NewGroup(GCnstSiteGroupLast, 0, True) then
              begin
                GCnstSiteGroup := O.CnstSiteGroup.Add;
                GCnstSiteGroup.Present := True;
                GCnstSiteGroupLast := -1;
              end;
              if C.Order(GCnstSiteGroupLast, 0, True, False) then
              begin
                ReadCnstSite(C, GCnstSiteGroup.CnstSite);
              end;
            end;
          end
          else if C.NameIs('NotifSite') then
          begin
            if C.Order(Last, 4, False, False) then
            begin
              if (GCnstSiteGroup = nil) or C.NewGroup(GCnstSiteGroupLast, 1, True) then
              begin
                GCnstSiteGroup := O.CnstSiteGroup.Add;
                GCnstSiteGroup.Present := True;
                GCnstSiteGroupLast := -1;
              end;
              if C.Order(GCnstSiteGroupLast, 1, True, False) then
              begin
                ReadNotifSite(C, GCnstSiteGroup.NotifSite);
