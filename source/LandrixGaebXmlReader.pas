            if C.Order(Last, 5, False, False) then
            begin
              ReadAddText(C, O.AddText.Add);
            end;
          end
          else if C.NameIs('CTR') then
          begin
            if C.Order(Last, 6, True, O.HasCTR) then
            begin
              ReadCTR(C, O.CTR);
