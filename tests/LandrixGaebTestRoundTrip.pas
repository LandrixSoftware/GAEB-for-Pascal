{ Round trip read - write - read with a field by field comparison of the
  models (plan, phase 1 step 10; LandrixGaebTestXmlCompare is generated by
  tools/schema/gen-gaeb-model.py): synthetic documents, the local corpus
  under tests/data/local and its faulty files. Local results are counts
  and element paths only, never values. }

unit LandrixGaebTestRoundTrip;

{$I LandrixGaeb.inc}

interface

procedure Register;

implementation

uses
  SysUtils,
  Classes,
  LandrixXmlBase,
  LandrixGaebTypes,
  LandrixGaebDiagnostics,
  LandrixGaebDetect,
  LandrixGaebXmlModel,
  LandrixGaebXmlReader,
  LandrixGaebXmlWriteBase,
  LandrixGaebXmlWriter,
  LandrixGaebXmlCheck,
  LandrixGaebRules,
  LandrixGaebTestXmlCompare,
  LandrixGaebTestNoValues,
  LandrixGaebTestFramework;

function DataDir(const ASub: string): string;
begin
  Result := RepositoryRoot + 'tests' + PathDelim + 'data' + PathDelim + ASub + PathDelim;
end;

procedure ListFiles(const ADir: string; AList: TStrings);
var
  SR: TSearchRec;
begin
  if FindFirst(ADir + '*', faAnyFile, SR) = 0 then
  try
    repeat
      if (SR.Name = '.') or (SR.Name = '..') then
        Continue;
      if (SR.Attr and faDirectory) <> 0 then
        ListFiles(ADir + SR.Name + PathDelim, AList)
      else
        AList.Add(ADir + SR.Name);
    until FindNext(SR) <> 0;
  finally
    FindClose(SR);
  end;
end;

function ReadModel(const ASource: TLandrixXmlUtf8; ADiags: TLandrixGaebDiagnostics;
  out ATarget: TLandrixGaebTarget): TLandrixGaebXmlGAEB;
var
  Det: TLandrixGaebDetection;
begin
  Result := LandrixGaebXmlReadBuffer(Pointer(ASource), Integer(Length(ASource)), ADiags, Det);
  ATarget := Det.Target;
end;

{ The target a model of ATarget is written to: itself, or 3.3/2021-05 for
  3.3/2019-11, which is read but not written. }
function WriteTarget(const ATarget: TLandrixGaebTarget): TLandrixGaebTarget;
begin
  Result := ATarget;
  if not LandrixGaebTargetIsSupported(Result, True) then
    Result := LandrixGaebTarget(gv33, ge2021_05, ATarget.Phase);
end;

function Problems(ADiags: TLandrixGaebDiagnostics): Integer;
var
  I: TLandrixGaebListIndex;
begin
  Result := 0;
  for I := 0 to ADiags.Count - 1 do
    if ADiags[I].Severity >= gsWarning then
      Inc(Result);
end;

function SameTarget(const A, B: TLandrixGaebTarget): Boolean;
begin
  Result := (A.Version = B.Version) and (A.Edition = B.Edition) and (A.Phase = B.Phase);
end;

{ Reads ASource, writes it (best effort, without the check: also invalid
  files go through), reads the output again and compares both models.
  Model equality alone does not show that the input was kept: AReadLosses
  counts the warnings and errors of the first read (an element the reader
  dropped is missing in both models), AWriteLosses those of the writer. }
procedure RoundTrip(const ASource: TLandrixXmlUtf8; ADiffs: TStrings; out AReadLosses, AWriteLosses: Integer);
var
  A, B: TLandrixGaebXmlGAEB;
  T, T2: TLandrixGaebTarget;
  Options: TLandrixGaebXmlWriteOptions;
  Output: TLandrixXmlUtf8;
  Diags: TLandrixGaebDiagnostics;
begin
  Options := LandrixGaebXmlDefaultWriteOptions;
  Options.Mode := gwmBestEffort;
  Options.Check := False;
  Diags := TLandrixGaebDiagnostics.Create;
  A := nil;
  B := nil;
  try
    A := ReadModel(ASource, Diags, T);
    AReadLosses := Problems(Diags);
    Diags.Clear;
    Output := LandrixGaebXmlWriteUtf8(A, WriteTarget(T), Options, Diags);
    AWriteLosses := Problems(Diags);
    B := ReadModel(Output, nil, T2);
    if not SameTarget(T2, WriteTarget(T)) then
      ADiffs.Add('/GAEB (target of the output)')
    else if not SameTarget(T2, T) and (T.Edition = ge2019_11) and (T2.Edition = ge2021_05) then
      { 3.3/2019-11 written as 2021-05: VersDate is the one of the target }
      B.GAEBInfo.VersDate := A.GAEBInfo.VersDate;
    CompareGaebModels(A, B, ADiffs);
  finally
    B.Free;
    A.Free;
    Diags.Free;
  end;
end;

{ ---- the comparison finds every kind of change ---- }

function FirstItemlist(G: TLandrixGaebXmlGAEB): TLandrixGaebXmlItemlist;
var
  I: Integer;
begin
  Result := nil;
  for I := 0 to Integer(G.Award.BoQ.BoQBody.Children.Count) - 1 do
    if (Result = nil) and (G.Award.BoQ.BoQBody.Children[I] is TLandrixGaebXmlBoQCtgy) then
      Result := TLandrixGaebXmlBoQCtgy(G.Award.BoQ.BoQBody.Children[I]).BoQBody.Itemlist;
end;

procedure TestCompare;
var
  Source: TLandrixXmlUtf8;
  A, B: TLandrixGaebXmlGAEB;
  T: TLandrixGaebTarget;
  Diffs: TStringList;
  Item: TLandrixGaebXmlItem;
  Mutation: Integer;

  function Has(const APart: string): Boolean;
  var
    I: Integer;
  begin
    Result := False;
    for I := 0 to Diffs.Count - 1 do
      if Pos(APart, Diffs[I]) > 0 then
        Result := True;
  end;

begin
  Source := ReadFileBytes(DataDir('legacy') + '31-elements.x83');
  Diffs := TStringList.Create;
  A := ReadModel(Source, nil, T);
  try
    for Mutation := 0 to 6 do
    begin
      B := ReadModel(Source, nil, T);
      try
        Item := FirstItemlist(B).Children[0] as TLandrixGaebXmlItem;
        case Mutation of
          1: Item.QU := 'X';
          2: Item.Qty.SetValue(10, 0);
          3: Item.Qty.SetValue(10001, 3);
          4: Item.MarkEmpty('QU');
          5: FirstItemlist(B).Children.Delete(FirstItemlist(B).Children.Count - 1);
          6: FirstItemlist(B).Children.Exchange(0, FirstItemlist(B).Children.Count - 1);
        else
          ;
        end;
        Diffs.Clear;
        CompareGaebModels(A, B, Diffs);
        case Mutation of
          0: CheckEquals(0, Diffs.Count, 'a model equals itself: ' + Diffs.Text);
          1: Check(Has('/Item[1]/QU'), 'changed value: ' + Diffs.Text);
          2: CheckEquals(0, Diffs.Count, 'decimals by value (10.000 = 10): ' + Diffs.Text);
          3: Check(Has('/Item[1]/Qty'), 'changed decimal: ' + Diffs.Text);
          4: Check(Has('/QU (empty mark)'), 'empty mark: ' + Diffs.Text);
          5: Check(Has('(number of children)'), 'removed child: ' + Diffs.Text);
          6: Check(Has('(kind of child)'), 'children in another order: ' + Diffs.Text);
        else
          ;
        end;
      finally
        B.Free;
      end;
    end;
  finally
    A.Free;
    Diffs.Free;
  end;
end;

{ ---- synthetic documents ---- }

procedure CheckFolder(const ASub: string);
var
  Files, Diffs: TStringList;
  I, ReadLosses, WriteLosses: Integer;
  Name: string;
begin
  Files := TStringList.Create;
  Diffs := TStringList.Create;
  try
    ListFiles(DataDir(ASub), Files);
    Files.Sort;
    for I := 0 to Files.Count - 1 do
    begin
      Name := ExtractFileName(Files[I]);
      if (Name = 'expected.txt') or (Pos('-invalid', Name) > 0) then
        Continue;
      Diffs.Clear;
      RoundTrip(ReadFileBytes(Files[I]), Diffs, ReadLosses, WriteLosses);
      CheckEquals(0, ReadLosses, ASub + '/' + Name + ': read without losses');
      CheckEquals(0, WriteLosses, ASub + '/' + Name + ': written without losses');
      CheckEquals(0, Diffs.Count, ASub + '/' + Name + ': the model survives the round trip: ' + Diffs.Text);
    end;
  finally
    Diffs.Free;
    Files.Free;
  end;
end;

procedure TestSynthetic;
begin
  CheckFolder('coverage');
  CheckFolder('legacy');
  CheckFolder('rules');
  CheckFolder('process');
end;

{ ---- local corpus: counts only ---- }

procedure TestLocal;
var
  Files, Diffs: TStringList;
  I, Compared, Equal, Failed, ReadLosses, WriteLosses, ReadLossFiles, WriteLossCount: Integer;
  Source: TLandrixXmlUtf8;
  Det: TLandrixGaebDetection;
  FirstDiff, FirstFailure: string;
begin
  if not DirectoryExists(DataDir('local')) then
  begin
    Skip('tests/data/local not present');
    Exit;
  end;
  Compared := 0;
  Equal := 0;
  Failed := 0;
  ReadLossFiles := 0;
  WriteLossCount := 0;
  FirstDiff := '';
  FirstFailure := '';
  Files := TStringList.Create;
  Diffs := TStringList.Create;
  try
    ListFiles(DataDir('local'), Files);
    for I := 0 to Files.Count - 1 do
    { messages of exceptions may quote the file: only the class is kept }
    try
      if Pos(PathDelim + 'faulty' + PathDelim, Files[I]) > 0 then
        Continue;
      Source := ReadFileBytes(Files[I]);
      Det := LandrixGaebDetectBuffer(Pointer(Source), Integer(Length(Source)), False, nil);
      if not Det.Accepted or (Det.Format <> gfXml) or not LandrixGaebTargetIsSupported(Det.Target, False) or
        not (Det.Target.Phase in [gp81, gp83, gp84, gp86]) or not (Det.Target.Version in [gv32, gv33]) then
        Continue;
      Inc(Compared);
      Diffs.Clear;
      RoundTrip(Source, Diffs, ReadLosses, WriteLosses);
      if ReadLosses > 0 then
        Inc(ReadLossFiles);
      Inc(WriteLossCount, WriteLosses);
      if Diffs.Count = 0 then
        Inc(Equal)
      else if FirstDiff = '' then
        FirstDiff := Diffs[0];
    except
      on E: Exception do
      begin
        Inc(Failed);
        if FirstFailure = '' then
          FirstFailure := E.ClassName;
      end;
    end;
  finally
    Diffs.Free;
    Files.Free;
  end;
  WriteLn('  Local.RoundTrip: ', Compared, ' file(s), ', Equal, ' with equal models, ', ReadLossFiles,
    ' with warnings or errors of the reader (losses before the round trip), ', WriteLossCount,
    ' loss(es) of the writer, ', Failed, ' failed');
  Check(Compared > 0, 'local files found');
  CheckEquals(0, Failed, 'no exception (first: ' + FirstFailure + ')');
  CheckEquals(0, WriteLossCount, 'the writer loses nothing the reader kept');
  CheckEquals(Compared, Equal, 'every model survives the round trip (first difference: ' + FirstDiff + ')');
end;

{ Faulty files: rejected with an exception of the library (and a
  position for XML that is not well-formed) or read with diagnostics;
  never another exception. }
procedure TestLocalFaulty;
var
  Files: TStringList;
  I, Count, Rejected, Diagnosed, Clean, Flagged, Failed: Integer;
  G: TLandrixGaebXmlGAEB;
  Source: TLandrixXmlUtf8;
  Diags: TLandrixGaebDiagnostics;
  Det: TLandrixGaebDetection;
  FirstFailure: string;
begin
  if not DirectoryExists(DataDir('local') + 'faulty' + PathDelim + 'xml') then
  begin
    Skip('tests/data/local/faulty/xml not present');
    Exit;
  end;
  Count := 0;
  Rejected := 0;
  Diagnosed := 0;
  Clean := 0;
  Flagged := 0;
  Failed := 0;
  FirstFailure := '';
  Files := TStringList.Create;
  try
    ListFiles(DataDir('local') + 'faulty' + PathDelim + 'xml' + PathDelim, Files);
    for I := 0 to Files.Count - 1 do
    begin
      Diags := TLandrixGaebDiagnostics.Create;
      try
        { messages of exceptions may quote the file or its name: only
          the class is kept }
        try
          Source := ReadFileBytes(Files[I]);
          Det := LandrixGaebDetectBuffer(Pointer(Source), Integer(Length(Source)), False, nil);
          if Det.Format <> gfXml then
            Continue;
          Inc(Count);
          G := LandrixGaebXmlReadBuffer(Pointer(Source), Integer(Length(Source)), Diags, Det);
          try
            if Diags.HasErrors then
              Inc(Diagnosed)
            else
            begin
              Inc(Clean);
              { read without error: the check or the rules must find it }
              LandrixGaebXmlCheckBuffer(Pointer(Source), Integer(Length(Source)), Diags, Det);
              LandrixGaebCheckRules(G, Det.Target, Diags);
              if Diags.HasErrors then
                Inc(Flagged);
            end;
          finally
            G.Free;
          end;
        except
          on ELandrixGaebError do
            Inc(Rejected);
          on E: ELandrixXmlError do
            if E.Line > 0 then
              Inc(Rejected)
            else
            begin
              Inc(Failed);
              if FirstFailure = '' then
                FirstFailure := 'ELandrixXmlError without position';
            end;
          on E: Exception do
          begin
            Inc(Failed);
            if FirstFailure = '' then
              FirstFailure := E.ClassName;
          end;
        end;
      finally
        Diags.Free;
      end;
    end;
  finally
    Files.Free;
  end;
  WriteLn('  Local.FaultyXml: ', Count, ' file(s): ', Rejected, ' rejected, ', Diagnosed, ' read with errors, ',
    Clean, ' read without error (', Flagged, ' of them with errors of the check or the rules), ', Failed,
    ' failed');
  Check(Count > 0, 'faulty XML files found');
  CheckEquals(0, Failed, 'only clean rejections (first: ' + FirstFailure + ')');
end;

procedure Register;
begin
  RegisterTest('RoundTrip.Compare', TestCompare);
  RegisterTest('RoundTrip.Synthetic', TestSynthetic);
  RegisterTest('Local.RoundTrip', TestLocal);
  RegisterTest('Local.FaultyXml', TestLocalFaulty);
end;

end.
