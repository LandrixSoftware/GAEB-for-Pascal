{
  "comment": [
    "Record types of GAEB 90 (exchange of bills of quantities, edition June 1990, with the STLB-Bau",
    "record 79 added in 1997) as far as the reader needs them. Own wording; names, positions, lengths",
    "and formats only.",
    "Every record is 80 characters: columns 1-2 the record type, 75-80 the record number (six digits,",
    "starting at 000001, without gaps). fields describe columns 3 to 74, without gaps or overlaps.",
    "type: alpha (any characters), text (a line of text), num (digits with an implied decimal point,",
    "scale = [integer digits, fraction digits]), int (digits without decimals), zz (three digits plus a",
    "digit or a space), sign (a minus or a space; the field named in sign of a num field), date",
    "(DD.MM.YY), time (HH:MM), oz (ordinal number, read with the mask), ozmask, code (one of values),",
    "filler (unused).",
    "A field that is not required may be all spaces: no value, which is not zero. A num field is",
    "written with leading zeros and without a sign; negative values carry a sign field.",
    "values: allowed codes besides the space (required fields: without the space).",
    "phases: per exchange phase, the records that must or may appear; a record that is not listed",
    "is not exchanged in that phase. States: must, may; mustIfPrices / mayIfPrices: only with",
    "KZPREIS X in 01; mustIfFreeQuantity: for every 23 with FREIEMEN; mustInLongForm: with KURZLANG L;",
    "mustIfBidderText: where a description asks for a bidder complement (TB X).",
    "bidderTexts: a description with TB X needs lines 26 with TEKZ B (always, or shortForm: KURZLANG K).",
    "onlySpaceInPhases: the field holds a space in these phases, no code.",
    "max: the most records of the type in one context (0 = any number). vendor: not part of GAEB 90.",
    "sequence: the order of the records within a context; the reader does not enforce it.",
    "placement: where contexts may stand (structured, own terms)."
  ],
  "recordLength": 80,
  "common": [
    {"name": "ZA", "from": 1, "to": 2, "required": true, "type": "alpha"},
    {"name": "SATZNR", "from": 75, "to": 80, "required": true, "type": "int"}
  ],
  "editions": {
    "90": "edition June 1990",
    " ": "edition November 1985 (VERSDTA all spaces)"
  },
  "freeRecordTypes": [70, 89],
  "undefinedRecordTypes": {
    "29": "listed once for phase 86 without a layout; read as an unknown record type"
  },
  "phases": {
    "81": {"title": "bill of quantities handed over (planning)", "read": true, "records": {
      "T0": "may", "T1": "may", "T9": "may", "00": "must", "01": "must", "02": "must", "03": "may",
      "07": "may", "08": "may", "10": "may", "11": "may", "12": "may", "20": "may", "21": "must",
      "24": "may", "25": "must", "26": "mustInLongForm", "27": "may", "28": "may", "31": "may", "33": "may",
      "34": "may", "35": "may", "41": "may", "42": "may", "79": "may", "99": "must"}},
    "82": {"title": "cost estimate based on items", "read": true, "records": {
      "T0": "may", "T1": "may", "T9": "may", "00": "must", "01": "must", "02": "must", "03": "may",
      "07": "may", "08": "must", "11": "may", "12": "may", "21": "must", "22": "must", "24": "may",
      "25": "must", "26": "mustInLongForm", "27": "may", "28": "may", "31": "may", "41": "may", "42": "may",
      "79": "may", "99": "must"}},
    "83": {"title": "invitation to tender", "read": true, "records": {
      "T0": "may", "T1": "may", "T9": "may", "00": "must", "01": "must", "02": "must", "03": "must",
      "06": "may", "07": "may", "08": "mustIfPrices", "10": "may", "11": "may", "12": "may",
      "20": "may", "21": "must", "23": "mayIfPrices", "24": "may", "25": "must", "26": "mustInLongForm",
      "27": "may", "28": "may", "31": "may", "32": "mayIfPrices", "33": "may", "34": "may",
      "35": "may", "41": "may", "42": "may", "45": "may", "46": "may", "47": "may", "79": "may",
      "99": "must"}},
    "84": {"title": "tender", "read": true, "records": {
      "T0": "may", "T1": "may", "T9": "may", "00": "must", "01": "must", "02": "must", "03": "must",
      "04": "must", "06": "may", "08": "must", "10": "may", "21": "mustIfFreeQuantity", "23": "must",
      "24": "may", "26": "mustIfBidderText", "30": "may", "32": "may", "33": "may", "34": "may", "35": "may",
      "41": "may", "42": "may", "45": "may", "46": "may", "47": "may", "99": "must"}},
    "85": {"title": "alternative tender", "read": true, "records": {
      "T0": "may", "T1": "may", "T9": "may", "00": "must", "01": "must", "02": "must", "03": "must",
      "04": "must", "06": "may", "07": "may", "08": "must", "10": "may", "11": "may", "12": "may",
      "20": "may", "21": "must", "23": "must", "24": "may", "25": "must", "26": "mustInLongForm", "27": "may",
      "28": "may", "30": "may", "31": "may", "32": "may", "33": "may", "34": "may", "35": "may",
      "41": "may", "42": "may", "45": "may", "46": "may", "47": "may", "79": "may", "99": "must"}},
    "86": {"title": "award", "read": true, "records": {
      "T0": "may", "T1": "may", "T9": "may", "00": "must", "01": "must", "02": "must", "03": "must",
      "04": "must", "06": "may", "07": "may", "08": "must", "10": "may", "11": "may", "12": "may",
      "20": "may", "21": "must", "23": "must", "24": "may", "25": "must", "26": "mustInLongForm", "27": "may",
      "28": "may", "30": "may", "31": "may", "32": "may", "33": "may", "34": "may", "35": "may",
      "41": "may", "42": "may", "45": "may", "46": "may", "47": "may", "79": "may", "99": "must"}}
  },
  "bidderTexts": {"83": "shortForm", "84": "always", "85": "always"},
  "phaseNotes": [
    "Phase 84: 26 only with TEKZ B.",
    "26 without TEKZ B: long form only (KURZLANG L); 84 has no form (KURZLANG space).",
    "Bidder complements are not exchanged in 81, 82 and 86.",
    "Phase 81: 34 taken from the overview matrix (missing in the per-phase list).",
    "79 is younger than the phase lists; allowed wherever items are."
  ],
  "positionKinds": ["NNN", "NNL", "NEN", "NEL", "NMN", "NML", "ANN", "ANL", "GNN", "GNL", "AEN", "AEL", "GMN", "GML", "SNN", "SNL"],
  "ozMask": {
    "length": 9,
    "levels": ["1", "2", "3", "4"],
    "item": "P",
    "index": "I",
    "fill": "0",
    "rules": [
      "P is required; at most four levels 1 to 4, each a run of equal digits; fill only on the right.",
      "Lower levels may stay empty in an ordinal number; leading zeros or spaces within a part."
    ]
  },
  "sequence": {
    "contract": [["T0", 1], ["T1", 0], ["T9", 1]],
    "header": [["00", 1], ["01", 1], ["02", 9], ["03", 1], ["04", 1], ["06", 1], ["07", 1], ["08", 1]],
    "lot": [["10", 1], ["33", 1]],
    "lotGroup": [["34", 99], ["35", 99]],
    "group": [["11", 1], ["12", 9], ["31", 1], ["32", 1]],
    "item": [["21", 1], ["22", 1], ["23", 1], ["30", 1], ["27", 999], ["28", 1], ["25", 9], ["26", 999]],
    "itemWithStlbBau": [["21", 1], ["27", 999], ["28", 1], ["25", 9], ["26", 999], ["79", 9], ["22", 1], ["23", 1], ["30", 1]],
    "subDescription": [["24", 1], ["28", 1], ["25", 9], ["26", 999]],
    "executionDescription": [["41", 1]],
    "executionBlock": [["42", 1], ["25", 9], ["26", 999]],
    "note": [["20", 1], ["26", 999]],
    "wages": [["45", 999], ["46", 9], ["47", 1]],
    "end": [["99", 1]]
  },
  "placement": {
    "contract": {"before": "header", "after": "end", "inside": false},
    "subDescription": {"parent": "item", "requires": "POSTYP L", "max": 99},
    "executionDescription": {"parts": "executionBlock", "beforeReferences": true},
    "group": {"nests": true, "hierarchyFrom": "OZ and OZMASKE", "optional": ["11", "31"]},
    "lot": {"nests": true, "requires": "LOSKZ X"}
  },
  "records": {
    "T0": {"title": "start of contract terms", "fields": [
      {"name": "FILLER", "from": 3, "to": 74, "type": "filler"}]},
    "T1": {"title": "line of contract terms", "max": 0, "fields": [
      {"name": "TEXT", "from": 3, "to": 74, "type": "text"}]},
    "T9": {"title": "end of contract terms", "fields": [
      {"name": "FILLER", "from": 3, "to": 74, "type": "filler"}]},
    "00": {"title": "opening record", "fields": [
      {"name": "FILLER", "from": 3, "to": 10, "type": "filler"},
      {"name": "DP", "from": 11, "to": 12, "required": true, "type": "code", "values": ["81", "82", "83", "84", "85", "86"]},
      {"name": "KURZLANG", "from": 13, "to": 13, "required": true, "type": "code", "values": ["K", "L"], "onlySpaceInPhases": ["84"]},
      {"name": "VERGAG", "from": 14, "to": 28, "type": "alpha"},
      {"name": "DVNRAG", "from": 29, "to": 36, "type": "alpha"},
      {"name": "BIETERAG", "from": 37, "to": 39, "type": "alpha"},
      {"name": "VERGAN", "from": 40, "to": 54, "type": "alpha"},
      {"name": "DVNRAN", "from": 55, "to": 62, "type": "alpha"},
      {"name": "OZMASKE", "from": 63, "to": 71, "required": true, "type": "ozmask"},
      {"name": "VERSDTA", "from": 72, "to": 73, "required": true, "type": "code", "values": ["90"], "spaceMeans": "edition 1985"},
      {"name": "LOSKZ", "from": 74, "to": 74, "type": "code", "values": ["X"]}]},
